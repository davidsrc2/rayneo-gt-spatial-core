<Project Sdk="Microsoft.NET.Sdk">
  <!-- Nimbo for Windows: tray app over nimbo.dll (rayneo/platform/nimbo_win.h). Unpackaged and
       self-contained (Windows App SDK included), so it runs from the build folder. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Nimbo</RootNamespace>
    <AssemblyName>Nimbo</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- PRI/resource tasks from the NuGet package: builds with the dotnet CLI, not only VS MSBuild. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon\Nimbo.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
  </ItemGroup>

  <!-- nimbo.dll from the CMake build (scripts/windows: build-win\Release). CI passes its own path. -->
  <PropertyGroup>
    <NimboNativeDir Condition="'$(NimboNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\build-win\Release\</NimboNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NimboNativeDir)nimbo.dll" Link="nimbo.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(NimboNativeDir)nimbo.dll')" />
    <Content Include="..\..\assets\icon\Nimbo.ico" Link="Assets\Nimbo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
