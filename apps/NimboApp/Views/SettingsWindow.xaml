<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nimbo.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="18" MaxWidth="600">
            <TextBlock Text="Ajustes" FontSize="24" FontWeight="SemiBold" />

            <StackPanel Spacing="8">
                <TextBlock Text="Calibración" FontSize="13" Opacity="0.7" />
                <TextBlock x:Name="CalibrationText" TextWrapping="Wrap" />
                <Button Content="Volver a calibrar" Click="Recalibrate_Click" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Disposición de los monitores" FontSize="13" Opacity="0.7" />
                <Border CornerRadius="12" Padding="12" Background="#0DFFFFFF" HorizontalAlignment="Left">
                    <Canvas x:Name="LayoutPreview" Width="260" Height="120" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="AddMonitorButton" Content="Añadir monitor" Click="AddMonitor_Click" />
                    <Button x:Name="RemoveMonitorButton" Content="Quitar monitor" Click="RemoveMonitor_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Uno grande" Tag="one" Click="Template_Click" />
                    <Button Content="Dos lado a lado" Tag="twoSide" Click="Template_Click" />
                    <Button Content="Dos apilados" Tag="twoStacked" Click="Template_Click" />
                    <Button Content="Tres en arco" Tag="threeArc" Click="Template_Click" />
                </StackPanel>
                <TextBlock x:Name="LayoutText" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Colocar a mano" FontSize="13" Opacity="0.7" />
                <Border CornerRadius="12" Background="#59000000" HorizontalAlignment="Left">
                    <Canvas x:Name="PlaceCanvas" Width="560" Height="250" Background="Transparent" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="PlaceSelected" VerticalAlignment="Center" Width="90" />
                    <Slider x:Name="PlaceScale" Width="220" Minimum="0.5" Maximum="1.6" StepFrequency="0.05"
                            ValueChanged="PlaceScale_Changed" />
                    <Button x:Name="PlaceReset" Content="Volver a la cuadrícula" Click="PlaceReset_Click" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                           Text="Arrastra cada monitor a su sitio; se mueve en las gafas a la vez. Se alinea solo con los demás (mantén Alt para colocarlo libre). Elige uno para cambiar su tamaño." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Ventanas flotantes" FontSize="13" Opacity="0.7" />
                <StackPanel x:Name="FloatList" Spacing="6" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="FloatChoice" Width="320" PlaceholderText="Elige una ventana abierta" />
                    <Button Content="Añadir" Click="FloatAdd_Click" />
                    <Button Content="Actualizar" Click="FloatRefresh_Click" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                           Text="Una sola ventana como panel propio (un vídeo encima de los monitores, un chat a un lado). Aparece encima de los monitores; muévela en «Colocar a mano». Se recuerdan: al abrir Nimbo vuelve a buscar cada una por su app. Mirando una, Ctrl+Alt+J trae la ventana real al frente con el cursor encima." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Cómo se ven" FontSize="13" Opacity="0.7" />
                <Slider x:Name="TextSizeSlider" Header="Tamaño del texto" Minimum="0" Maximum="4" StepFrequency="1"
                        SnapsTo="StepValues" ValueChanged="SliderChanged" />
                <Slider x:Name="DistanceSlider" Header="Distancia (m)" Minimum="1.2" Maximum="3" StepFrequency="0.1"
                        ValueChanged="SliderChanged" />
                <Slider x:Name="GapSlider" Header="Separación entre monitores (°)" Minimum="0" Maximum="6"
                        StepFrequency="0.5" ValueChanged="SliderChanged" />
                <Slider x:Name="CurvatureSlider" Header="Curvatura" Minimum="0" Maximum="1" StepFrequency="0.05"
                        ValueChanged="SliderChanged" />
                <Slider x:Name="SizeSlider" Header="Tamaño (°)" Minimum="28" Maximum="60" StepFrequency="1"
                        ValueChanged="SliderChanged" />
                <Slider x:Name="TiltSlider" Header="Inclinación (0 rectas, 1 hacia ti)" Minimum="0" Maximum="1"
                        StepFrequency="0.05" ValueChanged="SliderChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Inicio" FontSize="13" Opacity="0.7" />
                <ToggleSwitch x:Name="StartupToggle" Header="Abrir Nimbo al iniciar Windows" Toggled="Startup_Toggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Pantallas" FontSize="13" Opacity="0.7" />
                <ToggleSwitch x:Name="DimToggle" Header="Atenuar los monitores que no miras" Toggled="Changed" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                           Text="Cada pantalla mide lo que la imagen de las gafas y queda quieta en la habitación: gira la cabeza para pasar de una a otra. Nimbo pone las gafas en follow y, al parar, las devuelve a pinned. Ctrl+Alt+C las vuelve a poner delante." />
                <ToggleSwitch x:Name="FlatWallToggle" Toggled="Changed"
                              Header="Pared continua: pantallas planas, cada una girada hacia ti (también las de arriba y abajo) y pegadas borde con borde como un bloque curvado hacia ti, fijas en la sala (desactivado: con separación, curvatura e inclinación)" />
                <ToggleSwitch x:Name="VehicleToggle" Toggled="Changed"
                              Header="Modo vehículo (coche, tren, avión): las pantallas siguen solo una cuarta parte de los giros y acompañan las curvas del vehículo" />
                <ToggleSwitch x:Name="AnchorToggle" Toggled="Changed"
                              Header="Anclar las pantallas con la cabeza quieta (en el espacio a tamaño real va siempre incluido: quietas al parar, 1:1 al mover la cabeza)" />
                <ToggleSwitch x:Name="GrowGazeToggle" Toggled="Changed"
                              Header="Modo fijo (Ctrl+Alt+G): cambiar de pantalla mirándola (desactivado: solo con el ratón)" />
                <ToggleSwitch x:Name="LaptopToggle" Toggled="Changed"
                              Header="La pantalla del portátil es una de las de Nimbo (con 2 pantallas, la del portátil y una más; con 1, solo la del portátil)" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Fondo alrededor (Ctrl+Alt+F)" FontSize="13" Opacity="0.7" />
                <ComboBox x:Name="BackgroundCombo" Header="Fondo" MinWidth="280" SelectionChanged="BackgroundChanged" />
                <StackPanel x:Name="BackgroundImagePanel" Orientation="Horizontal" Spacing="10">
                    <Button Content="Elegir imagen…" Click="ChooseBackground_Click" />
                    <TextBlock x:Name="BackgroundImageText" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
                </StackPanel>
                <Slider x:Name="BackgroundSlider" Header="Intensidad (%)" Minimum="10" Maximum="100" StepFrequency="5"
                        ValueChanged="SliderChanged" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                           Text="Fijo en el espacio como las pantallas. En las gafas el negro es transparente: con «Ninguno» ves la habitación; con un fondo, la tapas. Una panorámica 2:1 rodea toda la habitación; otra foto ocupa 180° y se refleja detrás." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Cine en 3D con IA" FontSize="13" Opacity="0.7" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                           Text="Con las gafas en modo 3D, mira el vídeo y pulsa Ctrl+Alt+T: modo cine con relieve. Ctrl+Alt+T otra vez lo quita; Ctrl+Alt+P sale del cine (al volver las gafas a 2D sale solo)." />
                <Slider x:Name="DepthStrengthSlider" Header="Intensidad (%)" Minimum="0.5" Maximum="8" StepFrequency="0.25"
                        ValueChanged="SliderChanged" />
                <Slider x:Name="DepthPlaneSlider" Header="Plano de la pantalla (0 todo sale hacia ti, 1 todo hacia el fondo)"
                        Minimum="0" Maximum="1" StepFrequency="0.05" ValueChanged="SliderChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Atajos de teclado" FontSize="13" Opacity="0.7" />
                <Button Content="Ver todos los atajos (Ctrl+Alt+H)" Click="Shortcuts_Click" />
            </StackPanel>

            <Expander Header="Avanzado" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <Slider x:Name="FovSlider" Header="Campo de visión (°)" Minimum="15" Maximum="35"
                            StepFrequency="0.5" ValueChanged="SliderChanged" />
                    <Slider x:Name="IpdSlider" Header="Distancia entre ojos (mm)" Minimum="54" Maximum="72"
                            StepFrequency="1" ValueChanged="SliderChanged" />
                    <ToggleSwitch x:Name="GazeToggle" Header="El cursor sigue a tu mirada" Toggled="Changed" />
                    <ToggleSwitch x:Name="GatherToggle" Header="Traer mis ventanas al empezar" Toggled="Changed" />
                    <Slider x:Name="K1Slider" Header="Corrección de lente k1" Minimum="-0.2" Maximum="0.2"
                            StepFrequency="0.01" ValueChanged="SliderChanged" />
                    <Slider x:Name="K2Slider" Header="Corrección de lente k2" Minimum="-0.2" Maximum="0.2"
                            StepFrequency="0.01" ValueChanged="SliderChanged" />
                </StackPanel>
            </Expander>

            <StackPanel Spacing="8">
                <TextBlock Text="Actualizaciones" FontSize="13" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="UpdateButton" Content="Buscar actualizaciones" Click="Update_Click" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                               FontSize="12" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Diagnóstico" FontSize="13" Opacity="0.7" />
                <TextBlock x:Name="LiveDiagnosticsText" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Enviar informe" Click="Report_Click" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" FontSize="12" Opacity="0.7"
                               Text="Crea un zip en Descargas con el registro, tus ajustes, la calibración y los últimos 30 s del sensor, para enviarlo." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SetupDisplaysButton" Content="Preparar pantallas virtuales" Click="SetupDisplays_Click" />
                    <TextBlock x:Name="SetupDisplaysText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                               FontSize="12" Opacity="0.7" />
                </StackPanel>
                <HyperlinkButton Content="Abrir el registro" Click="OpenLog_Click" Padding="0" />
            </StackPanel>

            <Button Content="Hecho" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                    Click="Done_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
